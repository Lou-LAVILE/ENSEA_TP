#define BUFFER_MAX_SIZE 128

int fillBuffer(char * buffer, int size){
	int i;
	char received_char;
	int total = 0;

	for(i=0; i<size; i++){
		buffer[i] = 0;
	}

	do{
		HAL_UART_Receive(&huart1, (uint8_t*)&received_char, 1, 0);
	}
	while(received_char!='$');

	do{
		*buffer = received_char;
		HAL_UART_Receive(&huart1, (uint8_t*)&received_char, 1, 0);
		total++;
		buffer++;
	}
	while(received_char!='\n');

	*buffer = received_char;

	return total;
}

