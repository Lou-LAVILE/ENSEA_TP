//renvoie la taille de la trame reçu et rempli un tableau avec les caractères
int fillBuffer(char * buffer, int size){
	int i;
	char received_char;
	int total = 0;

	//initialise le tableau à zéro
	for(i=0; i<size; i++){
		buffer[i] = 0;
	}

	//démarre une réception
	HAL_UART_Abort(&huart1);

	//attend la réception d'un "$"
	do{
		HAL_UART_Receive(&huart1, (uint8_t*)&received_char, 1, 0);
	}
	while(received_char!='$');

	//enregistre les différents caractères dans le buffer + calcul le nbr d'élément
	do{
		*buffer = received_char;
		HAL_UART_Receive(&huart1, (uint8_t*)&received_char, 1, 0);
		total++;
		buffer++;
	}
	while(received_char!='\n');

	*buffer = received_char;

	return total;
}

// check si la transmition commence par $GPGGA
int isGPGCA(char *frame){
	char *start = "$GPGGA";
	for(int i=0; i<6; i++){
		if(frame[i]!=start[i]){
			return 0;
		}
	}
	return 1;
}

//extrait le checksum
int extractChecksum(char *buffer){
	while(*buffer!='*'){
		buffer++;
	}

	//récupère octet des deux dernier character et les convertis en entier
	return (buffer[1]&0x0f)*16+(buffer[2]&0x0f);
}

//calcul le checksum
int calculateChecksum(char *buffer){
	int checksum = 0;
	buffer++;
	while(*buffer!='*'){
		checksum = checksum^(*buffer);
		buffer++;
	}

	return checksum;
}

//check si la trame est correcte est renvoie un booléen
int checkFrame(char *buffer){
	return (isGPGCA(buffer)&&(extractChecksum(buffer)==calculateChecksum(buffer)));
}

